 <top-cell>10_4_1_MIM_OptionA</top-cell>
 <tags>
 </tags>
 <categories>
  <category>
   <name>MIM.1</name>
   <description>MIM.1 : Minimum MiM bottom plate spacing to the bottom plate metal
                 (whether adjacent MiM or routing metal). : 1.2µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.2</name>
   <description>MIM.2 : Minimum MiM bottom plate overlap of Via2 layer.
                 [This is applicable for via2 within 1.06um oversize of FuseTop layer
                 (referenced to virtual bottom plate)]. : 0.4µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.3</name>
   <description>MIM.3 : Minimum MiM bottom plate overlap of Top plate.</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.4</name>
   <description>MIM.4 : Minimum MiM top plate (FuseTop) overlap of Via2. : 0.4µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.5</name>
   <description>MIM.5 : Minimum spacing between top plate and
                  the Via2 connecting to the bottom plate. : 0.4µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.6</name>
   <description>MIM.6 : Minimum spacing between unrelated top plates. : 0.6µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.7</name>
   <description>MIM.7 : Min FuseTop enclosure by CAP_MK: 0um</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.8a</name>
   <description>MIM.8a : Minimum MIM cap area (defined by FuseTop area): 25µm²</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.8b</name>
   <description>MIM.8b : Maximum single MIM Cap area (Use multiple MIM caps in parallel
                   connection if bigger capacitors are required) (um2). : 10000µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.9</name>
   <description>MIM.9 : Min. via spacing for sea of via on MIM top plate. : 0.5µm</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.10</name>
   <description>MIM.10 : (a) There cannot be any Via1 touching MIM bottom plate Metal2.
                  (b) MIM bottom plate Metal2 can only be connected through the higher Via (Via2).</description>
   <categories>
   </categories>
  </category>
  <category>
   <name>MIM.11</name>
   <description>MIM.11 : Bottom plate of multiple MIM caps can be shared (for common nodes)
                  as long as total MIM area with that single common plate does not exceed MIM.8b rule.</description>
   <categories>
   </categories>
  </category>
 </categories>
